# ---------- Neo4j AuraDB ----------
# Values from the credentials file AuraDB gave you when you created the instance.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password
# Optional: leave empty to use the instance's default database
NEO4J_DATABASE=

# ---------- Web ----------
# Public URL of the FRONTEND. Browsers reach this API through the frontend's
# /api/* rewrite so the session cookie is first-party. OAuth callback URLs are
# <PUBLIC_APP_URL>/api/auth/<provider>/callback
PUBLIC_APP_URL=http://localhost:3000
PORT=4000
# Protects the daily Vercel Cron endpoints: GET /api/cron/keepalive (a small write so
# AuraDB Free never pauses) and GET /api/cron/reminders (death anniversary emails).
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Generate like JWT_SECRET.
# Leave empty locally unless you want to try them (they then answer 503).
CRON_SECRET=

# ---------- Auth ----------
# Random secret (32+ chars) for signing session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Anyone can register (email + password or social login) and gets a private tree.
# Every account is separate: it manages only its own tree (and trees it was
# invited to). There is no application-wide admin account.

# ---------- Email (verification + invitations) ----------
# Accounts (comma-separated emails, verified) that can connect the Gmail account
# below, through /api/admin/email.
# Empty: nobody (there is no admin by default).
ADMIN_EMAILS=
# "resend" (default) or "gmail".
EMAIL_PROVIDER=resend

# --- Gmail: sends from one Gmail / Google Workspace account through the Gmail API,
# using the Google sign-in client below (GOOGLE_CLIENT_ID/SECRET), no extra redirect URI.
# In the same Google Cloud project: enable the "Gmail API", and add the scope
# https://www.googleapis.com/auth/gmail.send on the OAuth consent screen.
# While the consent screen is in "Testing", Google expires refresh tokens after 7 days:
# publish the app (gmail.send is a sensitive scope), or use an Internal Workspace app.
# An admin connects the account by opening <PUBLIC_APP_URL>/api/admin/email/gmail/connect;
# it becomes the sender address (the display name is taken from EMAIL_FROM). Optional: only allow this address.
GMAIL_SENDER=
# Instead of connecting in the app: a refresh token of GMAIL_SENDER with the gmail.send scope.
GMAIL_REFRESH_TOKEN=

# --- Resend: API key from https://resend.com/api-keys. When empty, emails are not
# sent; they are printed to the backend console instead (handy for local dev).
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend. The default
# onboarding@resend.dev only delivers to your own Resend account's address.
EMAIL_FROM=Family Tree <onboarding@resend.dev>

# Social login: a provider is enabled when both values are set.
# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (New OAuth App)
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Photo uploads (optional) ----------
# Where uploaded person photos are stored: "s3" (any S3-compatible service) or
# "gdrive" (Google Drive). Empty disables uploads; photo links still work.
# Either way the files stay private and are served to tree members by the API.
PHOTO_STORAGE=

# S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze B2, Wasabi…
# Leave S3_ENDPOINT empty for AWS. R2: https://<account-id>.r2.cloudflarestorage.com with S3_REGION=auto
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to true when S3_ENDPOINT is set (needed by MinIO), false for AWS.
S3_FORCE_PATH_STYLE=
# Key prefix inside the bucket.
S3_PREFIX=photos/

# Google Drive: the id of the folder to put photos in (the last part of its URL).
GDRIVE_FOLDER_ID=
# Option A: a service account's JSON key (raw, or base64). Service accounts have no
# storage of their own, so the folder must be on a SHARED DRIVE that the
# service account is a member of (Content manager).
GDRIVE_SERVICE_ACCOUNT_JSON=
# Option B: a refresh token of a normal Google account with the scope
# https://www.googleapis.com/auth/drive. The client defaults to GOOGLE_CLIENT_ID/SECRET.
GDRIVE_REFRESH_TOKEN=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
