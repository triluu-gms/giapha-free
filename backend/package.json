{
  "name": "family-tree-api",
  "version": "1.0.0",
  "private": true,
  "description": "Family Tree REST API backed by Neo4j AuraDB",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "vercel-build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.writeFileSync('public/robots.txt','User-agent: *\\nDisallow: /\\n')\"",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "^9.0.3",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
