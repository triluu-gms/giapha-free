{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 3 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 0 * * *" }
  ]
}
