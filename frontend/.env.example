# URL of the Family Tree API (the backend project), no trailing slash.
# Used server-side only: the app proxies /api/* to it, so the browser never
# calls the backend directly and the session cookie stays first-party.
API_URL=http://localhost:4000

# Personal data agreement (/privacy, Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15):
# who runs this site (the data controller) and how to reach them about personal data.
# Built into the page, so redeploy after changing them.
NEXT_PUBLIC_PRIVACY_CONTROLLER=
NEXT_PUBLIC_PRIVACY_CONTACT=
